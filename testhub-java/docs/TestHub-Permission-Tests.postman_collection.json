  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "memberId",
      "value": ""
    },
    {
      "key": "envId",
      "value": ""
    },
    {
      "key": "user2Id",
      "value": ""
    },
    {
      "key": "user2Token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. 准备测试数据",
      "item": [
        {
          "name": "0.1 注册用户1（Owner/管理员）",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('用户1注册成功', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql(200);",
                  "    pm.expect(jsonData.data.accessToken).to.be.a('string');",
                  "    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
                  "    pm.collectionVariables.set('userId', jsonData.data.user.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"owner_user_{{$timestamp}}\",\n    \"email\": \"owner_{{$timestamp}}@test.com\",\n    \"password\": \"password123\",\n    \"realName\": \"项目负责人\",\n    \"phone\": \"13800000001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "0.2 注册用户2（普通成员）",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('用户2注册成功', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql(200);",
                  "    pm.expect(jsonData.data.accessToken).to.be.a('string');",
                  "    pm.collectionVariables.set('user2Token', jsonData.data.accessToken);",
                  "    pm.collectionVariables.set('user2Id', jsonData.data.user.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"member_user_{{$timestamp}}\",\n    \"email\": \"member_{{$timestamp}}@test.com\",\n    \"password\": \"password123\",\n    \"realName\": \"普通成员\",\n    \"phone\": \"13800000002\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        }
      ]
    },
