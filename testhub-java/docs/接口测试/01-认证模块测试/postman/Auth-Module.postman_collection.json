{
  "info": {
    "name": "TestHub - 认证模块",
    "description": "TestHub Java版本认证模块接口测试",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080/api"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. 登录",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.data && jsonData.data.accessToken) {",
              "        pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
              "        pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
              "        pm.collectionVariables.set('userId', jsonData.data.user.id);",
              "        pm.test('Token已保存', true);",
              "    }",
              "}",
              "",
              "pm.test('响应状态码200', function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('返回包含Token', function() {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.accessToken).to.be.a('string');",
              "    pm.expect(jsonData.data.refreshToken).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"test_admin\",\n    \"password\": \"Test123456\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "2. 注册-正常",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('响应状态码200', function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('注册成功返回Token', function() {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.accessToken).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"test_user_{{timestamp}}\",\n    \"password\": \"Test123456\",\n    \"email\": \"test_user_{{timestamp}}@test.com\",\n    \"realName\": \"测试用户\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "3. 注册-用户名已存在",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('用户名已存在应返回错误', function() {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.code).to.not.equal(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"test_admin\",\n    \"password\": \"Test123456\",\n    \"email\": \"another@test.com\",\n    \"realName\": \"测试\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "4. 注册-邮箱已使用",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('邮箱已注册应返回错误', function() {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.code).to.not.equal(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"new_user_test\",\n    \"password\": \"Test123456\",\n    \"email\": \"admin@test.com\",\n    \"realName\": \"测试\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "5. 注册-用户名为空",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('用户名为空应返回错误', function() {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.code).to.not.equal(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"\",\n    \"password\": \"Test123456\",\n    \"email\": \"test@test.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "6. 登录-用户名错误",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('用户名错误应返回错误', function() {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.code).to.not.equal(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"nonexistent_user\",\n    \"password\": \"Test123456\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "7. 登录-密码错误",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('密码错误应返回错误', function() {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.code).to.not.equal(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"test_admin\",\n    \"password\": \"WrongPassword123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "8. 刷新Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('刷新成功返回新Token', function() {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.data && jsonData.data.accessToken) {",
              "        pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
              "        pm.test('Token已更新', true);",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "refresh"]
        }
      }
    },
    {
      "name": "9. 刷新Token-无效Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('无效Token应返回错误', function() {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.code).to.not.equal(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"refreshToken\": \"invalid_token_here\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "refresh"]
        }
      }
    },
    {
      "name": "10. 获取当前用户信息",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('获取用户信息成功', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.username).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "me"]
        }
      }
    },
    {
      "name": "11. 登出",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('登出成功', function() {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "logout"]
        }
      }
    },
    {
      "name": "12. 无Token访问受保护接口",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('未授权访问应返回401', function() {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "me"]
        }
      }
    },
    {
      "name": "13. 无效Token访问",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('无效Token应返回401', function() {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer invalid_token_12345"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "me"]
        }
      }
    }
  ]
}
