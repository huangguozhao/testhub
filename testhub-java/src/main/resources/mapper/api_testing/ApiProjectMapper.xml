<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.testhub.modules.api_testing.mapper.ApiProjectMapper">

    <resultMap id="WithOwnerResultMap" type="com.testhub.modules.api_testing.domain.ApiProject">
        <id column="id" property="id"/>
        <result column="project_id" property="projectId"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="project_type" property="projectType"/>
        <result column="status" property="status"/>
        <result column="start_date" property="startDate"/>
        <result column="end_date" property="endDate"/>
        <result column="owner_id" property="ownerId"/>
        <result column="base_url" property="baseUrl"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="created_by" property="createdBy"/>
        <result column="updated_by" property="updatedBy"/>
        <!-- 嵌套负责人信息 -->
        <association property="owner" javaType="com.testhub.modules.system.domain.User">
            <id column="owner_user_id" property="id"/>
            <result column="owner_username" property="username"/>
            <result column="owner_email" property="email"/>
            <result column="owner_real_name" property="realName"/>
            <result column="owner_phone" property="phone"/>
            <result column="owner_avatar" property="avatar"/>
            <result column="owner_status" property="status"/>
        </association>
    </resultMap>

    <select id="selectPageWithOwner" resultMap="WithOwnerResultMap">
        SELECT p.*,
               u.id as owner_user_id,
               u.username as owner_username,
               u.email as owner_email,
               u.real_name as owner_real_name,
               u.phone as owner_phone,
               u.avatar as owner_avatar,
               u.status as owner_status
        FROM api_project p
        LEFT JOIN sys_user u ON p.owner_id = u.id
        WHERE p.is_deleted = 0
        <if test="projectId != null">
            AND p.project_id = #{projectId}
        </if>
        <if test="keyword != null and keyword != ''">
            AND (p.name LIKE CONCAT('%', #{keyword}, '%') OR p.description LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        ORDER BY p.created_at DESC
    </select>

</mapper>
